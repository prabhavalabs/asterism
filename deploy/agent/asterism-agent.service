# asterism-agent systemd unit. Installed by install.sh to
# /etc/systemd/system/asterism-agent.service.
#
# The agent is outbound-only (it dials hub.url and never listens), reads
# /proc, /sys/fs/cgroup and the Docker socket, and writes nothing. Drop the
# two capabilities (both lines) if port owners and root-only proxy configs
# are not needed; drop the docker group when Docker is reached through a
# socket proxy (sources.docker.endpoint: tcp://...).
[Unit]
Description=Asterism agent (outbound-only VPS telemetry)
Documentation=https://github.com/prabhavalabs/asterism
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=asterism-agent
Group=asterism-agent
SupplementaryGroups=docker systemd-journal
ExecStart=/usr/local/bin/asterism-agent run --config /etc/asterism/agent.yaml
Restart=always
RestartSec=5s
Environment=GOMAXPROCS=1 GOMEMLIMIT=12MiB GOGC=50

# Resource ceilings (BLUEPRINT §16: <= 15 MB RSS, <= 0.5% of a core).
MemoryHigh=48M
MemoryMax=64M
CPUQuota=10%
CPUWeight=20
TasksMax=32
Nice=10
IOSchedulingClass=idle

# Least privilege.
AmbientCapabilities=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
# Do not set ProcSubset=pid or ProtectProc=invisible: the agent needs
# /proc/net and the other processes' /proc entries.

[Install]
WantedBy=multi-user.target
