# Asterism hub systemd unit: /etc/systemd/system/asterism.service
#
# Serves the API and the embedded web UI on loopback (server.listen) behind a
# TLS reverse proxy (see nginx.conf in this folder). In collect.mode = "agent"
# the hub needs no host access at all: agents push to it.
#
#   install -m 0755 asterism /usr/local/bin/asterism
#   useradd --system --no-create-home --shell /usr/sbin/nologin asterism
#   install -d -m 0750 -o root -g asterism /etc/asterism
#   install -m 0640 -o root -g asterism asterism.toml /etc/asterism/asterism.toml
#   systemctl daemon-reload && systemctl enable --now asterism
[Unit]
Description=Asterism hub (VPS observatory API and web UI)
Documentation=https://github.com/prabhavalabs/asterism
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=asterism
Group=asterism
ExecStart=/usr/local/bin/asterism serve --config /etc/asterism/asterism.toml
Restart=always
RestartSec=5s
Environment=GOMEMLIMIT=192MiB

MemoryHigh=192M
MemoryMax=256M
CPUQuota=50%
TasksMax=128

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
